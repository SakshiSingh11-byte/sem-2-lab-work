#include <stdio.h>
#include <stdlib.h>
struct Student {
    char name[50];
    int roll;
    float marks;};
int main() {
    int n;
    struct Student *ptr;
    printf("Enter number of students: ");
    scanf("%d", &n);
    ptr = (struct Student*) malloc(n * sizeof(struct Student));
    if (ptr == NULL) {
        printf("Memory not allocated.\n");
        return 1; }
    for (int i = 0; i < n; ++i) {
    printf("\nStudent %d:\n", i + 1);
        printf("Name: ");
        scanf("%s", (ptr + i)->name);
        printf("Roll: ");
        scanf("%d", &(ptr + i)->roll);
        printf("Marks: ");
        scanf("%f", &(ptr + i)->marks); }
    printf("\n--- Student Records ---\n");
    for (int i = 0; i < n; ++i) {
        printf("Name: %s\tRoll: %d\tMarks: %.2f\n", (ptr + i)->name, (ptr + i)->roll, (ptr + i)->marks);}
    free(ptr);
    return 0;}
