#include <stdio.h>
struct Distance {
    float feet;
    float inch;};
int main() {
    struct Distance d1, d2, sum;
    printf("Enter 1st distance (feet and inches): ");
    scanf("%f %f", &d1.feet, &d1.inch);
    printf("Enter 2nd distance (feet and inches): ");
    scanf("%f %f", &d2.feet, &d2.inch);
    sum.feet = d1.feet + d2.feet;
    sum.inch = d1.inch + d2.inch;
    if (sum.inch >= 12.0) {
        sum.feet = sum.feet + (int)(sum.inch / 12);
        sum.inch = (int)sum.inch % 12; }
    printf("\nTotal Distance: %.2f feet and %.2f inches\n", sum.feet, sum.inch);
    return 0;
}
