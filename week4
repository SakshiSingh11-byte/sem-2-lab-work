#include <stdio.h>
#include <stdlib.h>

struct Node {
    int data;
    struct Node* next;
};

void insertBeg(struct Node** head, int val);
void insertMid(struct Node* head, int val, int pos);
void insertEnd(struct Node** head, int val);
void deleteBeg(struct Node** head);
void deleteMid(struct Node** head, int pos);
void deleteEnd(struct Node** head);
void traverse(struct Node* head);

int main() {
    struct Node* head = NULL;
    int choice, val, pos;

    while (1) {
        printf("\n1.Insert Beg\n2.Insert Mid\n3.Insert End\n4.Delete Beg\n5.Delete Mid\n6.Delete End\n7.Traverse\n8.Exit\nChoice: ");
        scanf("%d", &choice);

        switch (choice) {
            case 1:
                printf("Value: "); scanf("%d", &val);
                insertBeg(&head, val);
                break;
            case 2:
                printf("Value & Pos: "); scanf("%d %d", &val, &pos);
                insertMid(head, val, pos);
                break;
            case 3:
                printf("Value: "); scanf("%d", &val);
                insertEnd(&head, val);
                break;
            case 4:
                deleteBeg(&head);
                break;
            case 5:
                printf("Position: "); scanf("%d", &pos);
                deleteMid(&head, pos);
                break;
            case 6:
                deleteEnd(&head);
                break;
            case 7:
                traverse(head);
                break;
            case 8:
                exit(0);
            default:
                printf("Invalid choice!\n");
        }
    }
    return 0;
}

void insertBeg(struct Node** head, int val) {
    struct Node* newNode = (struct Node*)malloc(sizeof(struct Node));
    newNode->data = val;
    newNode->next = *head;
    *head = newNode;
}

void insertMid(struct Node* head, int val, int pos) {
    struct Node* temp = head;
    for (int i = 1; i < pos - 1 && temp != NULL; i++) temp = temp->next;
    if (temp != NULL) {
        struct Node* newNode = (struct Node*)malloc(sizeof(struct Node));
        newNode->data = val;
        newNode->next = temp->next;
        temp->next = newNode;
    }
}

void insertEnd(struct Node** head, int val) {
    struct Node* newNode = (struct Node*)malloc(sizeof(struct Node));
    newNode->data = val;
    newNode->next = NULL;
    if (*head == NULL) { *head = newNode; return; }
    struct Node* temp = *head;
    while (temp->next != NULL) temp = temp->next;
    temp->next = newNode;
}

void deleteBeg(struct Node** head) {
    if (*head == NULL) return;
    struct Node* temp = *head;
    *head = (*head)->next;
    free(temp);
}

void deleteMid(struct Node** head, int pos) {
    if (*head == NULL) return;
    struct Node* temp = *head;
    if (pos == 1) { *head = temp->next; free(temp); return; }
    for (int i = 1; temp != NULL && i < pos - 1; i++) temp = temp->next;
    if (temp == NULL || temp->next == NULL) return;
    struct Node* del = temp->next;
    temp->next = del->next;
    free(del);
}

void deleteEnd(struct Node** head) {
    if (*head == NULL) return;
    struct Node* temp = *head;
    if (temp->next == NULL) { *head = NULL; free(temp); return; }
    while (temp->next->next != NULL) temp = temp->next;
    free(temp->next);
    temp->next = NULL;
}

void traverse(struct Node* head) {
    while (head != NULL) {
        printf("%d -> ", head->data);
        head = head->next;
    }
    printf("NULL\n");
}
