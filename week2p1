#include <stdio.h>
struct Student {
    char name[50];
    char roll_no[20];
    char class_name[20];
};
int main() {
    struct Student s[5];
    int i;
    for (i = 0; i < 5; i++) {
        printf("Enter details for Student %d\n", i + 1);
        printf("Name: ");
        gets(s[i].name);
        printf("Roll No: ");
       gets(s[i].roll_no);
       printf("Class: "); gets(s[i].class_name);
        printf("\n");}
    printf(" Student Records -\n");
    for (i = 0; i < 5; i++) {
        printf("Student %d: %s, Roll: %s, Class: %s\n", i + 1, s[i].name, s[i].roll_no, s[i].class_name); }
    return 0;}
